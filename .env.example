# WealthOS environment variables
# Copy each app's needs; global infra vars first.

# --- packages/database ---

DATABASE_URL="postgresql://wealthos:change-this-postgres-password@localhost:5432/wealthos?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
REDIS_URL="redis://localhost:6379"
# When REDIS_URL is empty, BullMQ queues fall back to the in-process in-memory adapter.
PII_ENCRYPTION_KEY=""
# 32-byte base64 key for AES-256-GCM. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://partner.example.com,https://app.example.com"
KYC_MOCK_MODE="true"
NAVIAM_CRON_IST="0 48 * * *"

# --- apps/partner-dashboard ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# --- apps/investor-portal ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# --- apps/mobile-app ---

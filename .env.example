# WealthOS environment variables
# Copy this file to .env for local development.

DATABASE_URL="postgresql://wealthos:wealthos@localhost:5432/wealthos?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
REDIS_URL="redis://localhost:6379"
# When REDIS_URL is empty, BullMQ queues use the in-process adapter.
PII_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Generate a production key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"
KYC_MOCK_MODE="true"
LOCAL_DEMO_MODE="true"
NAVIAM_CRON_IST="0 48 * * *"

NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
